@model SpotifyMVC.Models.CancionViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@using Spotify.Core


@{
    ViewData["Title"] = "Canciones";
}


<h1>Canciones</h1>

<div>
    @if (Model?.canciones != null && Model.canciones.Any())
    {
        @foreach (Cancion cancion in Model.canciones)
        {
            <p>
                <a asp-route-id="@cancion.idCancion" asp-action="DetalleCancion">
                    @cancion.Titulo 
                </a>
                <img class="w-8 h-8 rounded-full" src="/images/@cancion.ImageUrl" alt="@cancion.Titulo">
            </p>
        }
    }
    else
    {
        <p>No hay canciones registradas.</p>
    }

    <a asp-action="CrearCancion">
        <button type="button">Crear Canción</button>
    </a>
</div>


