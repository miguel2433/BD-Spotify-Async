@model SpotifyMVC.Models.AlbumViewModel
@using Microsoft.AspNetCore.Mvc.Rendering


@{
    ViewData["Title"] = "Crear Album";
}


<h1>Crear Álbum</h1>

<form enctype="multipart/form-data" asp-action="CrearAlbum" method="post">
    <div>
        <label asp-for="Titulo"></label>
        <input asp-for="Titulo" placeholder="Nombre del álbum" />
    </div>

    <div>
        <label asp-for="FechaLanzamiento"></label>
        <input asp-for="FechaLanzamiento" type="date" />
    </div>

    <div>
        <label>Artista</label>
        <select asp-for="ArtistaId" asp-items="@(new SelectList(Model.artistas, "idArtista", "Nombre"))">
            <option value="">-- Selecciona un artista --</option>
        </select>
    </div>
    <div>
        <label asp-for="ImageUrl">Selecciona la imagen</label>
        <input class="input-file" type="file" asp-for="ImageUrl">
    </div>


    <button type="submit">Guardar</button>
</form>
