@using Spotify.Core
@model DetalleAlbumViewModel
@{
    ViewData["Title"] = "DetalleAlbum";
}

<div class="bg-zinc-900 grid grid-rows-[30vh_auto_auto] grid-cols-1 pb-10">
    <div class="relative flex justify-center flex-col items-start">
        <img class="absolute object-cover object-center h-[100%] w-[100%]" src="/Images/@Model.album.ImageUrl" alt="@Model.album.Titulo">
        <p class="absolute top-8 left-8 text-xl font-bold">Album</p>
        <h1 class="absolute left-8 text-5xl tracking-normal font-bold">@Model.album.Titulo</h1>
    </div>
    <div class="min-h-[50vh] fondo-gradiente-detalle-artista flex justify-start items-start flex-col">
        <h1 class="ml-4 mt-8 ">Canciones</h1>
        <div class="flex justify-center items-center flex-col">
        @foreach(Cancion cancion in Model.canciones){
            <div class="ml-4 mt-2 gap-3 flex flex-row justify-center items-center">
                <img class="h-10 w-10 rounded-full" src="/Images/@cancion.ImageUrl" alt="@cancion.Titulo">
                <h1>@cancion.Titulo</h1>
            </div>
        }
        </div>
    </div>
    <div class="flex justify-start items-center flex-row h-[100%] w-[100%]">
        <img class="ml-4 h-44 w-44 object-cover object-center rounded-full" src="/Images/@Model.artista.ImageUrl" alt="">
        <div class="ml-8 flex flex-col justify-between items-baseline">
            <h1>@Model.artista.NombreArtistico</h1>
            <p>Nombre: @Model.artista.Nombre</p>
            <p>Apellido: @Model.artista.Apellido</p>
        </div>
    </div>
</div>
