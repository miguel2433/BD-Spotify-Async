@using Spotify.Core

@model List<Album>
@{
    ViewData["Title"] = "Albums";
}

<h1>@ViewData["Title"]</h1>

<div>
    @foreach(Album album in Model){
        <p class="flex flex-row">
            <a asp-route-id="@album.idAlbum" asp-action="DetalleAlbum"> @album.Titulo</a>
            <img class="w-8 h-8 rounded-full" src="/images/@album.ImageUrl" alt="@album.Titulo">
        </p>
        
    }
    <button><a asp-action="CrearAlbum">Crear Album</a></button>
</div>
