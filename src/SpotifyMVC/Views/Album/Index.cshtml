@using Spotify.Core

@model List<Album>
@{
    ViewData["Title"] = "Albums";
}

<h1>@ViewData["Title"]</h1>

<div>
    @foreach(Album album in Model){
        <p><a asp-route-id="@album.idAlbum" asp-action="DetalleAlbum"> @album.Titulo</a></p>
    }
    <button><a asp-action="CrearAlbum">Crear Album</a></button>
</div>
