@using Spotify.Core
@model DetalleArtistaViewModel
@{
    ViewData["Title"] = "DetalleArtista";
}


<div class="grid h-[100%] bg-zinc-900 w-[100%] grid-cols-1 grid-rows-[40vh_1fr_1fr] rounded-md">
    <div class="relative text-start flex justify-center items-start flex-col">
        <img class="absolute w-[100%] h-[100%]" src="/images/@Model.artista.ImageUrl" alt="@Model.artista.NombreArtistico">
        <p class="ml-4 relative font-bold">Artista</p>
        <h1 class="ml-4 relative text-6xl font-bold">@Model.artista.NombreArtistico</h1>
    </div>
    <div class="fondo-gradiente-detalle-artista flex flex-col justify-center items-start">
        <h1 class="ml-4 mt-8 text-2xl font-bold font-mono">Albums</h1>
        @foreach(Album album in Model.albums){
            <div class="ml-4 mt-2 flex flex-row justify-center items-center gap-3">
                <h1 class="text-md">@album.idAlbum</h1>
                <img class="h-10 w-10 object-cover object-center rounded-md" src="/images/@album.ImageUrl" alt="@album.Titulo">
                <h1 class="text-md">@album.Titulo</h1>
            </div>
        }
    </div>
    <div class="ml-4 flex flex-col justify-center items-start">
        <h1 class="text-2xl font-bold font-mono">Canciones</h1>
            <div class="flex flex-row justify-center items-center">
                @foreach(Cancion cancion in Model.canciones){
                    <div class="flex flex-col justify-center items-center">
                        <img class="h-44 w-44 rounded-sm" src="/images/@cancion.ImageUrl" alt="@cancion.Titulo">
                        <h1 class="text-md text-start">@cancion.Titulo</h1>
                    </div>
                }
            </div>
    </div>
</div>
