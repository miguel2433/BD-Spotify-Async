@model List<Artista>
@using Microsoft.AspNetCore.Mvc.Rendering
@using Spotify.Core


@{
    ViewData["Title"] = "Artistas";
}


<h1>Artistas</h1>

<div>
    @if (Model != null && Model.Any())
    {
        @foreach (Artista artista in Model)
        {
            <p class="flex justify-start items-center flex-row">
                <a asp-route-id="@artista.idArtista" asp-action="DetalleArtista">
                    @artista.NombreArtistico 
                </a>
                <img class="rounded-full h-8 w-8" src="/images/@artista.ImageUrl" alt="@artista.NombreArtistico">
            </p>
        }
    }
    else
    {
        <p>No hay Artistas registrados.</p>
    }

    <a asp-action="CrearArtista">
        <button type="button">Crear Artista</button>
    </a>
</div>


