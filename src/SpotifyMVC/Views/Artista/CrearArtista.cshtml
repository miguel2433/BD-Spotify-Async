@model CrearArtistaViewModel
@using Microsoft.AspNetCore.Mvc.Rendering


@{
    ViewData["Title"] = "Crear Artista";
}


<h1>Crear Artista</h1>


<form asp-action="CrearArtista" enctype="multipart/form-data" method="post">
    <div>
        <label asp-for="artista.NombreArtistico">Nombre Artistico</label>
        <input asp-for="artista.NombreArtistico" placeholder="Nombre Artistico" />
    </div>


    <div>
        <label asp-for="artista.Nombre">Nombre del Artista</label>
        <input asp-for="artista.Nombre" placeholder="Nombre" />
    </div>
    <div>
        <label asp-for="artista.Apellido">Apellido del Artista</label>
        <input asp-for="artista.Apellido" placeholder="Apellido" />
    </div>
    <div>
        <label asp-for="ImageUrl">Selecciona la imagen</label>
        <input class="input-file" type="file" asp-for="ImageUrl">
    </div>  
    <button type="submit">Guardar</button>
</form>
