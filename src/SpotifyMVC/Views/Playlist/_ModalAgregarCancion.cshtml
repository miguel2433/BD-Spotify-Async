@model AgregarCancionAPlaylistViewModel

<div class="fixed inset-0 bg-black/70 backdrop-blur-sm flex justify-center items-center z-50 p-4" onclick="cerrarModal()">
    <div class="bg-gradient-to-br from-zinc-800 to-zinc-900 p-6 rounded-xl w-full max-w-md shadow-2xl border border-zinc-700 transform transition-all duration-300 scale-95 hover:scale-100" onclick="event.stopPropagation()">
        <div class="flex justify-between items-center mb-4">
            <h2 class="text-2xl font-bold text-white">
                <i class="fas fa-music mr-2 text-green-500"></i>Agregar a @Model.playlist.Nombre
            </h2>
            <button onclick="cerrarModal()" class="text-zinc-400 hover:text-white focus:outline-none">
                <i class="fas fa-times text-xl"></i>
            </button>
        </div>

        <form method="post" asp-action="AgregarCancion" class="space-y-4">
            <input type="hidden" asp-for="playlist.idPlaylist" />

            <div class="space-y-2">
                <label class="block text-sm font-medium text-zinc-300">Seleccionar Canción</label>
                <div class="relative">
                    <select asp-for="IdCancionSeleccionada" class="w-full px-4 py-3 rounded-lg bg-zinc-700/80 text-white border border-zinc-600 focus:border-green-500 focus:ring-2 focus:ring-green-500/50 outline-none transition-all">
                        @foreach (var c in Model.TodasLasCanciones)
                        {
                            <option value="@c.idCancion">@c.Titulo – @c.artista.NombreArtistico</option>
                        }
                    </select>
                    <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-zinc-400">
                        <i class="fas fa-chevron-down"></i>
                    </div>
                </div>
            </div>

            <div class="pt-2">
                <button type="submit" class="w-full bg-gradient-to-r from-green-600 to-green-500 hover:from-green-500 hover:to-green-600 text-white font-medium py-3 px-4 rounded-lg shadow-lg hover:shadow-green-500/20 transition-all duration-200 transform hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-opacity-50">
                    <i class="fas fa-plus-circle mr-2"></i>Agregar a la playlist
                </button>
            </div>
        </form>
    </div>
</div>
