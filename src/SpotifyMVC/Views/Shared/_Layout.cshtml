@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();

    bool esLoginOCrear = controller == "Usuario" && (action == "Login" || action == "Registrar");
    bool mostrarAside = User.Identity.IsAuthenticated && !esLoginOCrear;

    // Para main
    string mainColSpan = mostrarAside ? "1" : "2";
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SpotifyMVC</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/output.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn-uicons.flaticon.com/uicons-brands/css/uicons-brands.css">


</head>

<body class="bg-zinc-950 text-white h-screen w-full grid grid-rows-[10vh_1fr] grid-cols-[25vw_1fr]">
    <header class="col-span-2 row-span-1 flex justify-between items-center px-8">
        <a asp-area="" asp-controller="Home" asp-action="Index" class="text-lg font-bold">
        SpotifyMVC
        <i class="ml-1 fa-brands fa-spotify text-xl text-green-500"></i>
        </a>
        <ul class="flex gap-4">
        @if(User.IsInRole("Admin")){
            <li><a asp-controller="Album" asp-action="CrearAlbum" class="nav-link text-white">Albums</a></li>
            <li><a asp-controller="Cancion" asp-action="CrearCancion" class="nav-link text-white">Canciones</a></li>
            <li><a asp-controller="Artista" asp-action="CrearArtista" class="nav-link text-white">Artistas</a></li>
            <li><a asp-controller="Genero" asp-action="CrearGenero" class="nav-link text-white">Géneros</a></li>
        }
        @if (!User.Identity.IsAuthenticated)
        {
            <li><a asp-controller="Usuario" asp-action="Login" class="nav-link text-white">Login</a></li>
            <li><a asp-controller="Usuario" asp-action="Registrar" class="nav-link text-white">Registrarse</a></li>
        }
        else
        {
            <li>
                <form asp-controller="Usuario" asp-action="Logout" method="post">
                    <button type="submit" class="text-white hover:text-red-400">Logout</button>
                </form>
            </li>
        }
        
        </ul>
    </header>

    @if (mostrarAside)
    {
        <aside class="row-span-2 col-span-1 px-2 pb-2 flex justify-center items-center">
            <div class="flex justify-center items-center h-full w-full rounded-md bg-zinc-900">
                <h1 class="selft-start">Aside</h1>
            </div>
        </aside>
    }
    <div class="row-span-2 pb-2 col-span-@mainColSpan overflow-auto">
        <main class="rounded-t-md px-2">
            @RenderBody()
        </main>

        <footer class="px-2 flex justify-center items-center ">
            <div class="text-center rounded-b-md bg-zinc-900 flex justify-center py-4 items-center w-[100%]">
                <div class="w-[90%] py-8 grid grid-cols-3 grid-rows-1 border-y-2 border-zinc-700">
                    <div class="flex justify-end items-center flex-col">
                        <h1>Tecnologias</h1>
                        <a href="https://dev.mysql.com/doc/" class="text-zinc-500 hover:text-zinc-50 hover:underline flex justify-center items-center gap-2">
                            <p>Mysql</p>
                            <i class="fi fi-brands-mysql text-blue-500"></i>
                        </a>
                        <a href="https://dotnet.microsoft.com/es-es/languages/csharp" class="text-zinc-500 hover:text-zinc-50 flex justify-center items-center gap-2">
                            <p class="hover:underline">Csharp</p>
                            <span class=" h-5 w-5 flex justify-center items-center text-zinc-50 rounded-full bg-purple-800">
                                <p class="text-[10px] font-bold">C</p>
                                <p class="text-[6px] font-medium">#</p>
                            </span>
                        </a>
                        <a href="https://dappertutorial.net/" class="text-zinc-500 hover:text-zinc-50 flex justify-center items-center gap-2">
                            <p class="hover:underline">Dapper</p>
                            <img class="h-4 w-4 bg-zinc-900" src="~/assets/dapper.svg" alt="">
                        </a>
                        <a href="https://learn.microsoft.com/en-us/aspnet/core/mvc/overview?view=aspnetcore-9.0" class="text-zinc-500 hover:text-zinc-50 flex justify-center items-center gap-2">
                            <p class="hover:underline">Asp Net Core mvc</p>
                            <img class="h-4 w-4 mt-1 bg-zinc-900" src="~/assets/asp-net-coresvg.svg" alt="">
                        </a>
                    </div>
                    <div class="flex flex-col justify-center items-center">
                        <h1>Integrantes</h1>

                        <a href="https://github.com/miguel2433" class="flex items-center gap-2 text-zinc-500 cursor-pointer hover:text-zinc-50">
                            <span class="hover:underline">Miguel Verduguez</span>
                            <i class="fi fi-brands-github text-base mt-1"></i>
                        </a>

                        <a href="https://github.com/JosuGuzman" class="flex items-center gap-2 text-zinc-500 cursor-pointer hover:text-zinc-50">
                            <span class="hover:underline">Josu Guzman</span>
                            <i class="fi fi-brands-github text-base mt-1"></i>
                        </a>

                        <a href="https://github.com/reneterrazas" class="flex items-center gap-2 text-zinc-500 cursor-pointer hover:text-zinc-50">
                            <span class="hover:underline">Rene Terrazas</span>
                            <i class="fi fi-brands-github text-base mt-1"></i>
                        </a>
                    </div>

                    <div class="flex justify-start items-center flex-col">
                        <h1>Contactos</h1>
                        <div class="mt-2 flex justify-center items-center flex-row gap-3">
                            <a href="https://x.com/" class="flex justify-center items-center gap-2 text-zinc-500 cursor-pointer  ">
                                <i class="fa-brands fa-x-twitter text-xl hover:text-zinc-50"></i>
                            </a>    
                            <a href="https://www.instagram.com/" class="flex justify-center items-center gap-2 text-zinc-500 cursor-pointer ">
                                <i class="fi fi-brands-instagram text-xl hover:text-purple-800"></i>
                            </a>    
                            <a href="https://www.facebook.com/" class="flex justify-center items-center gap-2 text-zinc-500 cursor-pointer">
                                <i class="fi fi-brands-facebook text-xl hover:text-blue-700"></i>
                            </a> 
                        </div>                          
                    </div>
                </div>
            </div>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
