@using Spotify.Core
@model HomeViewModel
@{
    ViewData["Title"] = "Home Page";
}

    <div class="pl-8 fondo-gradiente rounded-md h-[100%] w-[100%] grid grid-rows-3 grid-cols-1">
        <div class="flex flex-col items-center">
        <h1 class="text-2xl font-bold mb-4">Artistas</h1>

        <div class="relative w-full">
            <button id="prev" class="flex justify-center ml-4 items-center h-8 w-8  absolute left-0 top-1/2 -translate-y-1/2 bg-gray-800 text-white p-2 rounded-full z-10">
            &#8592;
            </button>

            <div id="carousel" class="no-scrollbar flex overflow-x-auto scroll-smooth snap-x snap-mandatory gap-4 px-10">
            @foreach (Artista artista in Model.artistas) {
                <div class="carousel__slide snap-center flex-shrink-0 text-center p-2 flex flex-col items-center w-48">
                <img class="h-44 w-44 rounded-md bg-black object-cover" src="/images/@artista.ImageUrl" alt="@artista.Nombre">
                <p class="mt-2 font-medium">@artista.NombreArtistico</p>
                <p class="text-gray-500 text-sm">Artista</p>
                </div>
            }
            </div>

            <button id="next" class="flex justify-center mr-4 items-center h-8 w-8 absolute right-0 top-1/2 -translate-y-1/2 bg-gray-800 text-white p-2 rounded-full z-10">
            &#8594;
            </button>
        </div>
        </div>
        <div class="flex justify-center items-center flex-col">
            <h1>Canciones</h1>
                @foreach(Cancion cancion in Model.canciones){
                <p>
                    @cancion.Titulo
                </p>
            }
        </div>
        <div class="flex justify-center items-center flex-col">
            <h1>Albums</h1>
                @foreach(Album album in Model.albunes){
                <p>
                    @album.Titulo
                </p>
            }
        </div>
    </div>

@section Scripts{
    <script>
      const carousel = document.getElementById('carousel');
      document.getElementById('next').onclick = () => carousel.scrollBy({ left: 200, behavior: 'smooth' });
      document.getElementById('prev').onclick = () => carousel.scrollBy({ left: -200, behavior: 'smooth' });
    </script>
}
