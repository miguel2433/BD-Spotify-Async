@using Spotify.Core
@model HomeViewModel
@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="underline">Hello world!</h1>
    <div class="mt-8 w-full flex justify-around items-center flex-row">
        <div>
        <h1 >Artistas</h1>
            @foreach(Artista artista in Model.artistas){
                <p>
                    @artista.NombreArtistico
                </p>
            }
        </div>
        <div>
            <h1>Canciones</h1>
                @foreach(Cancion cancion in Model.canciones){
                <p>
                    @cancion.Titulo
                </p>
            }
        </div>
        <div>
            <h1>Albums</h1>
                @foreach(Album album in Model.albunes){
                <p>
                    @album.Titulo
                </p>
            }
        </div>
    </div>
</div>
